              "fieldId": "user_id",
              "fieldValue": "={{ $(\"Loop Over Items\").item.json.id }}"
            },
            {
              "fieldId": "location",
              "fieldValue": "={{ $(\"Loop Over Items\").item.json.location }}"
            },
            {
              "fieldId": "temperature",
              "fieldValue": "={{ $json.main.temp }}"
            },
            {
              "fieldId": "condition",
              "fieldValue": "={{ $json.weather[0].description }}"
