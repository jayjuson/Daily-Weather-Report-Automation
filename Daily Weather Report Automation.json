    {
      "parameters": {
        "sendTo": "={{ $(\"Loop Over Items\").item.json.email }}",
        "subject": "=Your Daily Weather Report for {{ $(\"Loop Over Items\").item.json.location }}",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 520px; margin: 0 auto; border: 1px solid #e0e0e0; border-radius: 12px; overflow: hidden;\">\n  \n  <div style=\"background: #1a73e8; padding: 28px 24px 20px; text-align: center;\">\n    <p style=\"color: #ffffff; font-size: 12px; margin: 0 0 6px; letter-spacing: 1px;\">DAILY WEATHER REPORT</p>\n    <p style=\"color: #ffffff; font-size: 22px; font-weight: bold; margin: 0;\">{{ $('Loop Over Items').item.json.location }}</p>\n    <p style=\"color: #ffffff; font-size: 12px; margin: 6px 0 0; opacity: 0.75;\">{{ $today.toFormat('cccc, LLLL d, yyyy') }}</p>\n  </div>\n\n  <div style=\"padding: 24px; background: #ffffff;\">\n    <p style=\"font-size: 15px; color: #333333; margin: 0 0 20px;\">Good morning, <strong>{{ $('Loop Over Items').item.json.name }}!</strong> Here's your weather update for today.</p>\n\n    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-bottom: 20px;\">\n      <tr>\n        <td width=\"33%\" style=\"text-align: center; background: #f5f5f5; border-radius: 8px; padding: 14px;\">\n          <p style=\"font-size: 22px; font-weight: bold; margin: 0 0 4px; color: #1a73e8;\">{{ $('HTTP Request').item.json.main.temp }}°C</p>\n          <p style=\"font-size: 11px; color: #888888; margin: 0;\">Temperature</p>\n        </td>\n        <td width=\"4%\"></td>\n        <td width=\"29%\" style=\"text-align: center; background: #f5f5f5; border-radius: 8px; padding: 14px;\">\n          <p style=\"font-size: 14px; font-weight: bold; margin: 0 0 4px; color: #333333; text-transform: capitalize;\">{{ $('HTTP Request').item.json.weather[0].description }}</p>\n          <p style=\"font-size: 11px; color: #888888; margin: 0;\">Condition</p>\n        </td>\n        <td width=\"4%\"></td>\n        <td width=\"30%\" style=\"text-align: center; background: #f5f5f5; border-radius: 8px; padding: 14px;\">\n          <p style=\"font-size: 22px; font-weight: bold; margin: 0 0 4px; color: #1a73e8;\">{{ $('HTTP Request').item.json.main.humidity }}%</p>\n          <p style=\"font-size: 11px; color: #888888; margin: 0;\">Humidity</p>\n        </td>\n      </tr>\n    </table>\n\n    <div style=\"background: #e8f0fe; border-radius: 8px; padding: 12px 14px; margin-bottom: 20px;\">\n      <p style=\"font-size: 13px; color: #1a73e8; margin: 0;\">&#9730; Tip: Check conditions before heading out today!</p>\n    </div>\n\n    <div style=\"border-top: 1px solid #e0e0e0; padding-top: 16px; text-align: center;\">\n      <p style=\"font-size: 11px; color: #aaaaaa; margin: 0;\">Sent automatically by n8n &middot; Powered by OpenWeatherMap</p>\n    </div>\n  </div>\n\n</div>",
        "options": {}
      },
